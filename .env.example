# Base URL of the Express API. Required: all products, carts, orders and
# payments come from it. Server-side only, never exposed to the browser.
COMMERCE_SERVER_URL=http://127.0.0.1:4000

# Must match server/.env INTERNAL_API_TOKEN when the API requires one.
# Server-side only; sent to Express as X-Internal-Token.
INTERNAL_API_TOKEN=
