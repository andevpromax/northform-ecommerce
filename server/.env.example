# Express API listen address. Binding to anything other than loopback, or
# NODE_ENV=production, requires INTERNAL_API_TOKEN.
HOST=127.0.0.1
PORT=4000

# Shared secret that Next.js must send as X-Internal-Token (min. 32 chars).
# Leave empty for local development on 127.0.0.1.
INTERNAL_API_TOKEN=

# Guest sessions idle longer than this lose their cart. Orders are kept.
SESSION_TTL_HOURS=24

# Docker Compose PostgreSQL (compose.yaml)
POSTGRES_USER=northform
POSTGRES_PASSWORD=change-me
POSTGRES_DB=northform
POSTGRES_PORT=5432

# Prisma connection strings. Tests only ever use TEST_DATABASE_URL, whose
# database name must end in _test.
DATABASE_URL=postgresql://northform:change-me@127.0.0.1:5432/northform
TEST_DATABASE_URL=postgresql://northform:change-me@127.0.0.1:5432/northform_test
