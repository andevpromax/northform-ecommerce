{
	"name": "ecommerce-showcase",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=22"
	},
	"packageManager": "pnpm@10.0.0",
	"scripts": {
		"dev": "next dev",
		"build": "next build",
		"start": "next start",
		"typecheck": "tsc --noEmit",
		"lint": "biome lint src",
		"lint:fix": "biome lint --write src",
		"format": "biome format --write .",
		"format:check": "biome format .",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:e2e": "playwright test",
		"server:dev": "pnpm --filter @ecommerce-showcase/server dev",
		"server:build": "pnpm --filter @ecommerce-showcase/server build",
		"server:start": "pnpm --filter @ecommerce-showcase/server start",
		"server:typecheck": "pnpm --filter @ecommerce-showcase/server typecheck",
		"server:test": "pnpm --filter @ecommerce-showcase/server test",
		"server:db:up": "pnpm --filter @ecommerce-showcase/server db:up",
		"server:db:down": "pnpm --filter @ecommerce-showcase/server db:down",
		"server:db:migrate": "pnpm --filter @ecommerce-showcase/server db:migrate",
		"server:db:deploy": "pnpm --filter @ecommerce-showcase/server db:deploy",
		"server:db:seed": "pnpm --filter @ecommerce-showcase/server db:seed",
		"server:db:studio": "pnpm --filter @ecommerce-showcase/server db:studio",
		"setup": "node scripts/setup-env.mjs",
		"prepare": "lefthook install"
	},
	"dependencies": {
		"@hookform/resolvers": "3.10.0",
		"@radix-ui/react-dialog": "1.1.15",
		"@radix-ui/react-label": "2.1.7",
		"@radix-ui/react-radio-group": "1.3.8",
		"@radix-ui/react-slot": "1.2.3",
		"@tanstack/react-query": "5.90.12",
		"class-variance-authority": "0.7.1",
		"clsx": "2.1.1",
		"date-fns": "4.1.0",
		"libphonenumber-js": "1.12.31",
		"next": "16.2.3",
		"react": "19.2.3",
		"react-dom": "19.2.3",
		"react-hook-form": "7.62.0",
		"tailwind-merge": "2.6.0",
		"talkr": "3.5.1",
		"zod": "3.25.76",
		"zustand": "5.0.0"
	},
	"devDependencies": {
		"@axe-core/playwright": "4.14.0",
		"@biomejs/biome": "1.9.4",
		"@playwright/test": "1.58.2",
		"@testing-library/jest-dom": "6.6.3",
		"@testing-library/react": "16.3.0",
		"@testing-library/user-event": "14.6.1",
		"@types/node": "22.19.9",
		"@types/react": "19.2.7",
		"@types/react-dom": "19.2.3",
		"@vitejs/plugin-react": "4.6.0",
		"autoprefixer": "10.4.21",
		"happy-dom": "17.6.3",
		"lefthook": "^2.2.2",
		"postcss": "8.5.6",
		"tailwindcss": "3.4.19",
		"typescript": "5.9.3",
		"vitest": "3.2.4"
	}
}
